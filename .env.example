# Salin ke .env.local untuk development lokal, dan isi variabel yang sama di
# Environment Variables Vercel untuk deployment. Jangan commit nilai asli.

# Access key Web3Forms untuk formulir kontak. Dibaca saat build dan ikut masuk
# ke JavaScript publik, jadi bukan secret server.
# Tanpa nilai ini formulir kontak selalu menampilkan pesan gagal.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Connection string PostgreSQL (Neon) untuk endpoint /api/analytics. Hanya
# dibaca di server (Vercel Function); jangan beri awalan VITE_.
# Tanpa nilai ini /api/analytics membalas 503 dan kunjungan tidak tercatat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
